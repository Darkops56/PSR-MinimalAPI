@model HomeViewModel

@if (Model.FeaturedPizzas.Any())
{
    var featured = Model.FeaturedPizzas.First();
    <section class="hero-slider-section">
        <div class="hero-slider-container">
            <div class="hero-slide">
                <div class="hero-slide-content">
                    <div class="hero-badge">
                        <i class="bi bi-fire"></i>
                        <span>¡Especial de la Casa!</span>
                    </div>
                    <h1 class="hero-title font-display">
                        @featured.Nombre Artesanal
                    </h1>
                    <p class="hero-description">
                        @featured.Descripcion
                    </p>
                    <div class="hero-actions">
                        <div class="hero-price">
                            $@featured.Precio.ToString("N2")
                        </div>
                        <button type="button" class="btn btn-brand-primary"
                                data-open-customizer
                                data-pizza-id="@featured.Id"
                                data-pizza-name="@featured.Nombre"
                                data-pizza-desc="@featured.Descripcion"
                                data-pizza-price="@featured.Precio"
                                data-pizza-img="@Url.Content(PizzaImageHelper.GetImagePath(featured.Nombre))">
                            <i class="bi bi-sliders me-1"></i>
                            <span>Personalizar y Pedir</span>
                        </button>
                    </div>
                </div>
                <div class="d-none d-md-block text-center position-relative">
                    <img src="@Url.Content(PizzaImageHelper.GetImagePath(featured.Nombre))" alt="@featured.Nombre"
                         class="img-fluid rounded-circle border border-warning border-opacity-50"
                         style="width: 240px; height: 240px; object-fit: cover; box-shadow: 0 10px 30px rgba(0,0,0,0.6);" />
                </div>
            </div>
        </div>
    </section>
}
