@model HomeViewModel

<div class="category-bar">
    <button type="button" class="category-chip active" data-category="Todas">
        <i class="bi bi-grid-fill"></i>
        <span>Todas las Pizzas</span>
    </button>
    <button type="button" class="category-chip" data-category="Clásicas">
        <i class="bi bi-star-fill text-warning"></i>
        <span>Clásicas</span>
    </button>
    <button type="button" class="category-chip" data-category="Especiales">
        <i class="bi bi-fire text-danger"></i>
        <span>Especiales</span>
    </button>
    <button type="button" class="category-chip" data-category="Gourmet">
        <i class="bi bi-gem text-info"></i>
        <span>Gourmet</span>
    </button>
</div>
