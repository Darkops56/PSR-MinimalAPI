<div class="modal-overlay" id="auth-guard-modal">
    <div class="modal-card text-center p-4 p-md-5">
        <div class="display-4 text-warning mb-3">
            <i class="bi bi-person-lock"></i>
        </div>

        <h3 class="font-display h4 text-light mb-2">¡Iniciá Sesión para Continuar!</h3>
        <p class="text-muted small mb-4">
            Para poder añadir al carrito el producto debes iniciar sesión.
        </p>

        <div class="d-flex flex-column gap-2 mb-3">
            <a asp-controller="Auth" asp-action="Login" class="btn btn-brand-primary py-2 d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-box-arrow-in-right"></i>
                <span>Iniciar Sesión</span>
            </a>
            <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-secondary py-2 text-light border-opacity-50 d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-person-plus"></i>
                <span>Crear Cuenta Nueva</span>
            </a>
        </div>

        <button type="button" class="btn btn-link text-muted small p-0 text-decoration-none" data-close-modal>
            Seguir mirando el menú
        </button>
    </div>
</div>
