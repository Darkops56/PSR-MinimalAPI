<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BearPizzeria</title>
    
    <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS (CDN + Local Fallback) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Design System CSS -->
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-cliente-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0")"
      data-token="@(User.FindFirst("Token")?.Value ?? "")"
      data-user="@(User.Identity?.IsAuthenticated ?? false ? System.Text.Json.JsonSerializer.Serialize(new {
          id = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
          username = User.Identity?.Name,
          nombre = User.FindFirst("Nombre")?.Value,
          email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value,
          direccion = User.FindFirst("Direccion")?.Value,
          telefono = User.FindFirst("Telefono")?.Value,
          token = User.FindFirst("Token")?.Value
      }) : "")">

    <!-- Header Sticky con Navbar reorganizado -->
    <partial name="_Header" />

    <!-- Hamburger Drawer (Mobile) -->
    <partial name="_HamburgerDrawer" />

    <!-- Main Content Canvas -->
    <main role="main" class="main-content container">
        @RenderBody()
    </main>

    <!-- Mobile Bottom Navigation (< 768px) -->
    <partial name="_MobileBottomNav" />

    <!-- Modals & Offcanvas Sidebars -->
    <partial name="_CustomizerModal" />
    <partial name="_AuthGuardModal" />
    <partial name="_RepeatOrderStockModal" />
    <partial name="_AddressSidebar" />
    <partial name="_ToastNotifications" />

    <!-- Footer Compacto -->
    <partial name="_Footer" />

    <!-- Bootstrap 5 Bundle JS (CDN + Local Fallback) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Main JS Orchestrator -->
    <script type="module" src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
