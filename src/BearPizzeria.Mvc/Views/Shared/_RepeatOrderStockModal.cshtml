<!-- Modal de Advertencia de Stock al Repetir Pedido -->
<div class="modal-overlay" id="repeat-order-stock-modal">
    <div class="modal-card border border-warning border-opacity-50">
        <div class="modal-header d-flex align-items-center justify-content-between pb-3 border-bottom border-secondary border-opacity-25">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                <h3 class="font-display h5 text-light mb-0">Aviso de Stock Disponible</h3>
            </div>
            <button type="button" class="btn-close btn-close-white" data-close-repeat-modal aria-label="Cerrar"></button>
        </div>

        <div class="modal-body py-3">
            <p class="text-muted small mb-3" id="repeat-stock-modal-message">
                Algunas pizzas de tu pedido anterior no tenían suficiente stock. Se agregaron al carrito las unidades máximas disponibles.
            </p>

            <div class="table-responsive rounded-3 border border-secondary border-opacity-25 bg-dark bg-opacity-50 p-2 mb-3">
                <table class="table table-dark table-borderless align-middle mb-0 small">
                    <thead>
                        <tr class="text-muted border-bottom border-secondary border-opacity-25">
                            <th>Pizza</th>
                            <th class="text-center">Solicitadas</th>
                            <th class="text-center">Disponibles</th>
                            <th class="text-end">Agregadas</th>
                        </tr>
                    </thead>
                    <tbody id="repeat-stock-table-body">
                        <!-- Filas inyectadas dinámicamente por JS -->
                    </tbody>
                </table>
            </div>

            <div class="alert alert-warning bg-warning bg-opacity-10 border-warning border-opacity-25 text-warning small mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill fs-5 flex-shrink-0"></i>
                <span>Revisá tu carrito para verificar las cantidades antes de confirmar tu compra.</span>
            </div>
        </div>

        <div class="modal-footer pt-3 border-top border-secondary border-opacity-25 d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-light btn-sm" data-close-repeat-modal>Entendido</button>
            <a href="/Cart" class="btn btn-brand-primary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-cart-fill"></i>
                <span>Ver Mi Carrito</span>
            </a>
        </div>
    </div>
</div>
