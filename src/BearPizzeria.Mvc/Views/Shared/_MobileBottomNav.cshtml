<nav class="mobile-bottom-nav">
    <a asp-controller="Home" asp-action="Index"
       class="bottom-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
        <i class="bi bi-house-door-fill"></i>
        <span>Inicio</span>
    </a>

    <a asp-controller="Cart" asp-action="Index"
       class="bottom-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cart" ? "active" : "")">
        <i class="bi bi-bag-fill text-warning"></i>
        <span>Carrito</span>
        <span class="cart-badge-pill cart-badge-count position-absolute top-0 end-0 translate-middle-y" style="display: none;">0</span>
    </a>

    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <a asp-controller="Profile" asp-action="Index"
           class="bottom-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")">
            <i class="bi bi-person-circle"></i>
            <span>Perfil</span>
        </a>
    }
    else
    {
        <a asp-controller="Auth" asp-action="Login"
           class="bottom-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Auth" ? "active" : "")">
            <i class="bi bi-box-arrow-in-right"></i>
            <span>Ingresar</span>
        </a>
    }
</nav>
