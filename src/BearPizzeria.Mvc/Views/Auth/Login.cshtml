@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center align-items-center py-5" style="min-height: 75vh;">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <div class="card card-dark p-4 p-md-5">
            
            <!-- Header -->
            <div class="text-center mb-4">
                <div class="display-4 mb-2">🐻🍕</div>
                <h1 class="font-display h3 text-light mb-2">¡Bienvenido de nuevo!</h1>
                <p class="text-muted small">Ingresá a tu cuenta para continuar con tu pedido.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 mb-4 rounded-3 small">
                    @Html.ValidationSummary(true)
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Campo Usuario -->
                <div class="mb-4">
                    <label asp-for="Username" class="form-label fw-bold text-light small mb-2">Nombre de Usuario</label>
                    <input asp-for="Username" class="form-control form-control-custom w-100"
                           placeholder="Ej: jaimito_pizza" autocomplete="username" />
                    <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Campo Contraseña -->
                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-bold text-light small mb-2">Contraseña</label>
                    <input asp-for="Password" type="password" class="form-control form-control-custom w-100"
                           placeholder="••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Botón Submit -->
                <button type="submit" class="btn btn-brand-primary w-100 py-3 mt-2 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-box-arrow-in-right fs-5"></i>
                    <span>Iniciar Sesión</span>
                </button>
            </form>

            <!-- Footer Enlace Registro -->
            <div class="mt-4 pt-4 border-top border-secondary border-opacity-25 text-center text-muted small">
                ¿No tenés una cuenta?
                <a asp-action="Register" class="auth-highlight-link ms-1">
                    Registrate acá <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
        </div>
    </div>
</div>
