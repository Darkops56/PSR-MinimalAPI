@model OrdersViewModel
@{
    ViewData["Title"] = "Historial Completo de Pedidos";
    var hasFilter = !string.IsNullOrEmpty(Model.FechaFiltro);
}

<div class="d-flex flex-column gap-4 py-2">
    <!-- Encabezado con Botón de Regreso -->
    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 pb-3 border-bottom border-secondary border-opacity-25">
        <div class="d-flex align-items-center gap-3">
            <div class="fs-2">📜</div>
            <div>
                <h1 class="font-display h3 text-light mb-0">Historial Completo de Pedidos</h1>
                <p class="text-muted small mb-0">Revisá el detalle y estado de todas tus compras en BearPizzeria.</p>
            </div>
        </div>
        <div>
            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i>
                <span>Volver a mi Perfil</span>
            </a>
        </div>
    </div>

    <!-- Barra de Filtro por Fecha (Año, Mes, Día) -->
    <div class="card card-dark p-3 p-md-4">
        <form asp-controller="Profile" asp-action="Orders" method="get" class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-md-4">
                <label class="form-label text-light small fw-bold mb-1">
                    <i class="bi bi-calendar-event text-warning me-1"></i> Filtrar por Fecha (Año / Mes / Día)
                </label>
                <input type="date" name="fecha" value="@Model.FechaFiltro" class="form-control form-control-custom w-100" />
            </div>
            
            <div class="col-12 col-sm-6 col-md-5 d-flex gap-2">
                <button type="submit" class="btn btn-brand-primary btn-sm rounded-pill px-4 py-2 d-flex align-items-center gap-1">
                    <i class="bi bi-funnel-fill"></i>
                    <span>Aplicar Filtro</span>
                </button>

                @if (hasFilter)
                {
                    <a asp-controller="Profile" asp-action="Orders" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 d-flex align-items-center gap-1 text-light">
                        <i class="bi bi-x-circle"></i>
                        <span>Limpiar Filtro</span>
                    </a>
                }
            </div>
        </form>

        @if (hasFilter)
        {
            <div class="mt-3 pt-2 border-top border-secondary border-opacity-10 d-flex align-items-center gap-2">
                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning px-3 py-1 rounded-pill">
                    Filtro activo: @Model.FechaFiltro
                </span>
                <span class="text-muted small">Mostrando @Model.TotalCount @(Model.TotalCount == 1 ? "coincidencia" : "coincidencias")</span>
            </div>
        }
    </div>

    <!-- Lista de Pedidos Estilo Recibo -->
    @if (!Model.Pedidos.Any())
    {
        <div class="card card-dark p-5 text-center my-4">
            <div class="display-3 mb-3">🍕📦</div>
            <h2 class="font-display h4 text-light mb-2">No se encontraron pedidos</h2>
            <p class="text-muted small mb-4">
                @(hasFilter ? $"No hay compras registradas para la fecha seleccionada ({Model.FechaFiltro})." : "Aún no has realizado suficientes compras para ver en esta sección.")
            </p>
            <div>
                @if (hasFilter)
                {
                    <a asp-controller="Profile" asp-action="Orders" class="btn btn-outline-warning px-4 py-2 me-2">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        <span>Ver Todos los Pedidos</span>
                    </a>
                }
                <a asp-controller="Home" asp-action="Index" class="btn btn-brand-primary px-4 py-2">
                    <i class="bi bi-cart-plus me-1"></i>
                    <span>Ir a Pedir Pizzas</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-1">
            <span class="text-muted small fw-bold">
                Mostrando @Model.Pedidos.Count de @Model.TotalCount @(Model.TotalCount == 1 ? "pedido" : "pedidos") (Página @Model.PageNumber de @Model.TotalPages)
            </span>
            @if (!hasFilter)
            {
                <span class="badge bg-dark border border-secondary border-opacity-25 text-muted small px-2 py-1">
                    *(Los primeros 3 pedidos se muestran en tu Perfil principal)*
                </span>
            }
        </div>

        <div class="d-flex flex-column gap-4">
            @foreach (var pedido in Model.Pedidos)
            {
                var isOrderDone = pedido.Estado == "Entregado";
                var isTravel = pedido.Estado == "EnViaje";

                <div class="card card-dark p-4 border border-secondary border-opacity-25 rounded-3">
                    <!-- Cabecera del Recibo -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center pb-3 mb-3 border-bottom border-secondary border-opacity-25 gap-2">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="font-display h5 text-light mb-0">Pedido #@pedido.Id</span>
                                <span class="badge @(isOrderDone ? "bg-success text-success border-success" : isTravel ? "bg-info text-info border-info" : "bg-warning text-warning border-warning") bg-opacity-25 border rounded-pill px-3 py-1"
                                      data-order-history-badge="@pedido.Id">
                                    @(isOrderDone ? "✅ Entregado" : isTravel ? "🛵 En Camino" : "🔥 En Preparación")
                                </span>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="bi bi-calendar3 me-1"></i>
                                @pedido.FechaPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm") hs
                            </div>
                        </div>
                        <div class="text-sm-end">
                            <span class="badge bg-dark border border-secondary border-opacity-25 text-muted px-2 py-1">
                                @pedido.Items.Sum(i => i.Cantidad) @(pedido.Items.Sum(i => i.Cantidad) == 1 ? "pizza" : "pizzas")
                            </span>
                        </div>
                    </div>

                    <!-- Desglose Tipo Recibo de Compra (Fila por Fila) -->
                    <div class="table-responsive mb-3">
                        <table class="table table-dark table-borderless align-middle mb-0 small">
                            <thead>
                                <tr class="text-muted border-bottom border-secondary border-opacity-10">
                                    <th scope="col" style="min-width: 140px;">Variedad / Item</th>
                                    <th scope="col" class="text-center">Tamaño</th>
                                    <th scope="col" class="text-center">Cant.</th>
                                    <th scope="col" class="text-end">P. Unitario</th>
                                    <th scope="col" class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in pedido.Items)
                                {
                                    <tr class="border-bottom border-secondary border-opacity-10">
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span>🍕</span>
                                                <span class="fw-bold text-light">@item.PizzaNombre</span>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary bg-opacity-25 text-warning border border-secondary border-opacity-25 px-2 py-1">
                                                @item.Tamano
                                            </span>
                                        </td>
                                        <td class="text-center fw-bold text-light">@item.Cantidad</td>
                                        <td class="text-end text-muted">$@item.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end fw-bold text-light">$@item.Subtotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pie del Recibo con Total -->
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                        <span class="text-muted small fw-bold">Total del Pedido:</span>
                        <span class="font-display fw-bold text-warning fs-4">$@pedido.Total.ToString("N2")</span>
                    </div>
                </div>
            }
        </div>

        <!-- Paginador de 10 en 10 -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Navegación de pedidos" class="d-flex justify-content-center mt-4">
                <ul class="pagination pagination-dark mb-0 gap-1">
                    <!-- Botón Anterior -->
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-item-link px-3 py-2 rounded-pill border border-secondary border-opacity-25 text-light text-decoration-none"
                           asp-controller="Profile" asp-action="Orders" asp-route-page="@(Model.PageNumber - 1)" asp-route-fecha="@Model.FechaFiltro">
                            <i class="bi bi-chevron-left me-1"></i> Anterior
                        </a>
                    </li>

                    <!-- Números de Página -->
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item">
                            <a class="page-item-link px-3 py-2 rounded-circle border border-secondary border-opacity-25 text-decoration-none @(i == Model.PageNumber ? "bg-warning text-dark fw-bold" : "text-light")"
                               asp-controller="Profile" asp-action="Orders" asp-route-page="@i" asp-route-fecha="@Model.FechaFiltro">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Botón Siguiente -->
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-item-link px-3 py-2 rounded-pill border border-secondary border-opacity-25 text-light text-decoration-none"
                           asp-controller="Profile" asp-action="Orders" asp-route-page="@(Model.PageNumber + 1)" asp-route-fecha="@Model.FechaFiltro">
                            Siguiente <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
